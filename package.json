{
  "name": "wfe",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=12.4.1"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 --filter \"@wfe/*\" build",
    "types": "pnpm -r --workspace-concurrency=1 --filter \"@wfe/*\" types",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs tests/tooling/*.test.mjs",
    "test:unit": "vitest run",
    "check": "node scripts/check.mjs",
    "test:integrity": "node scripts/theme-palette.mjs --check && node scripts/icons.mjs --check && node scripts/check-matching.mjs && node scripts/check-calendar.mjs && node scripts/check-kobalte.mjs && node scripts/check-virtual.mjs && node scripts/check-imports.mjs && node scripts/check-controls.mjs && node scripts/check-charts.mjs",
    "types:unit": "tsc --project tests/unit/tsconfig.json",
    "types:examples": "node scripts/typecheck-examples.mjs",
    "test:ssr": "node scripts/test-ssr.mjs",
    "test:qualification": "node scripts/qualify.mjs",
    "test:contracts": "node scripts/test-contracts.mjs",
    "audit:vendor": "node scripts/audit-vendor.mjs --bundles"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@solidjs/vite-plugin": "3.0.0-next.50",
    "@solidjs/web": "2.0.0-rc.18",
    "@types/node": "26.5.1",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.10.0",
    "globals": "17.6.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "solid-js": "2.0.0-rc.18",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "@wfe/components": "workspace:*",
    "zod": "4.6.5",
    "@wfe/form": "workspace:*",
    "@wfe/generator": "workspace:*",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.1.8",
    "@wfe/shell": "workspace:*",
    "@wfe/sync": "workspace:*"
  }
}
