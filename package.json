{
  "name": "wfe",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=12.4.1"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 --filter \"@wfe/*\" build",
    "types": "pnpm -r --workspace-concurrency=1 --filter \"@wfe/*\" types",
    "lint": "oxlint .",
    "lint:types": "oxlint --type-aware --config .oxlintrc.types.json .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs tests/tooling/*.test.mjs",
    "test:unit": "vitest run",
    "check": "node scripts/check.mjs",
    "test:integrity": "node scripts/theme-palette.mjs --check && node scripts/icons.mjs --check && node scripts/check-matching.mjs && node scripts/check-calendar.mjs && node scripts/check-kobalte.mjs && node scripts/check-virtual.mjs && node scripts/check-imports.mjs && node scripts/check-controls.mjs && node scripts/check-charts.mjs && node scripts/check-vendor-integrity.mjs",
    "types:unit": "tsc --project tests/unit/tsconfig.json",
    "types:examples": "node scripts/typecheck-examples.mjs",
    "test:consumers": "node tests/consumers/run.mjs",
    "test:ssr": "node scripts/test-ssr.mjs",
    "test:qualification": "node scripts/qualify.mjs",
    "test:contracts": "node scripts/test-contracts.mjs",
    "audit:vendor": "node scripts/audit-vendor.mjs --bundles"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "3.0.1",
    "@solidjs/web": "2.0.0",
    "@tanstack/db": "1.0.0-rc.1.5",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "@wfe/components": "workspace:*",
    "@wfe/form": "workspace:*",
    "@wfe/generator": "workspace:*",
    "@wfe/shell": "workspace:*",
    "@wfe/sync": "workspace:*",
    "fake-indexeddb": "6.2.8",
    "jsdom": "31.0.1",
    "oxc-parser": "0.159.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "prettier": "3.10.1",
    "publint": "0.3.25",
    "solid-js": "2.0.0",
    "tsdown": "0.23.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
