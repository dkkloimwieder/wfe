{
  "name": "wfe",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.4.1"
  },
  "scripts": {
    "build": "pnpm --filter @wfe/components build",
    "types": "pnpm --filter @wfe/components types",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.mjs tests/tooling/*.test.mjs",
    "test:unit": "vitest run",
    "check": "node scripts/check.mjs",
    "test:integrity": "node scripts/check-calendar.mjs && node scripts/check-kobalte.mjs && node scripts/check-virtual.mjs && node scripts/check-imports.mjs",
    "types:examples": "node scripts/typecheck-examples.mjs",
    "test:ssr": "node scripts/test-ssr.mjs",
    "test:qualification": "node scripts/qualify.mjs",
    "test:contracts": "node scripts/test-contracts.mjs",
    "audit:vendor": "node scripts/audit-vendor.mjs --bundles"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@solidjs/vite-plugin": "3.0.0-next.49",
    "@solidjs/web": "2.0.0-rc.14",
    "@types/node": "26.5.1",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.10.0",
    "globals": "17.6.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "solid-js": "2.0.0-rc.14",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "@wfe/components": "workspace:*",
    "zod": "4.6.5"
  }
}
