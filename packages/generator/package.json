{
  "name": "@wfe/generator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "wfe-source": "./src/index.ts",
      "solid": "./dist/index.jsx",
      "node": "./dist/server/index.js",
      "default": "./dist/index.js"
    },
    "./chart": {
      "types": "./dist/chart/index.d.ts",
      "wfe-source": "./src/chart/index.ts",
      "solid": "./dist/chart/index.jsx",
      "node": "./dist/server/chart/index.js",
      "default": "./dist/chart/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "types": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@wfe/components": "workspace:*",
    "@wfe/form": "workspace:*"
  },
  "peerDependencies": {
    "solid-js": ">=2.0.0-rc.18 <3.0.0",
    "@solidjs/web": ">=2.0.0-rc.18 <3.0.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.50",
    "@solidjs/web": "2.0.0-rc.18",
    "solid-js": "2.0.0-rc.18",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vite": "8.3.3"
  }
}
