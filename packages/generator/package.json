{
  "name": "@wfe/generator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "wfe-source": "./src/index.ts",
      "solid": "./dist/source/index.js",
      "node": "./dist/server/index.js",
      "import": "./dist/client/index.js"
    },
    "./chart": {
      "types": "./dist/client/chart/index.d.ts",
      "wfe-source": "./src/chart/index.ts",
      "solid": "./dist/source/chart/index.js",
      "node": "./dist/server/chart/index.js",
      "import": "./dist/client/chart/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown && node ../../scripts/build-source.mjs generator",
    "types": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@wfe/components": "workspace:*",
    "@wfe/form": "workspace:*"
  },
  "peerDependencies": {
    "solid-js": ">=2.0.0-rc.14 <3.0.0",
    "@solidjs/web": ">=2.0.0-rc.14 <3.0.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
